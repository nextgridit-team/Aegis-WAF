  "rule": {
    "schema_version": 1,
    "name": "Ahsay servlet-flag bypass guard",
    "scope": {
      "site_id": 1
    },
    "all": [
      {
        "field": "method",
        "op": "in",
        "value": [
          "POST"
        ]
      },
      {
        "field": "path",
        "op": "regex",
        "value": "(?i)^/obs/api/json/[^/]+\\.do$"
      },
      {
        "field": "json_body",
        "op": "regex",
        "value": "^Y$",
        "key": "/FromServlet"
      }
    ],
    "action": "observe",
    "ttl_seconds": 3600
  },
  "tests": [
    {
      "method": "POST",
      "path": "/obs/api/json/ListSystemUsers.do",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"FromServlet\": \"Y\"}",
      "name": "matching synthetic request",
      "expected_match": true
    },
    {
      "method": "POST",
      "path": "/obs/api/json/ListSystemUsers.do",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{}",
      "name": "nonmatching synthetic request",
      "expected_match": false
    },
    {
      "method": "GET",
      "path": "/aegis-rule-control-health",
      "headers": {},
      "body": "",
      "name": "ordinary health request",
      "expected_match": false
    }
  ]
}
