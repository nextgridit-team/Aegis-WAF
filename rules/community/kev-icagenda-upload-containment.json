{
  "schema_version": 1,
  "revision": 1,
  "id": "kev-icagenda-upload-containment",
  "pack": "iCagenda request guards",
  "technology": [
    "icagenda",
    "http"
  ],
  "cves": [
    "CVE-2026-48939"
  ],
  "description": "Temporary endpoint containment. Blocks multipart iCagenda registration submissions.",
  "affected_versions": "icagenda.com iCagenda extension for Joomla: 3.2.1-4.0.7; verify complete affected/fixed ranges and deployment prerequisites in the linked CNA/vendor records.",
  "coverage": "Blocks multipart iCagenda registration submissions.",
  "limitations": "Only the declared request facts and bounded native matcher are covered. No vulnerable-deployment reproduction was performed. Direct-origin access, alternate routes/encodings and uninspectable facts remain outside this rule. Apply vendor fixes; this is not complete CVE protection.",
  "false_positive_risk": "Legitimate multipart registration forms and attachments are denied.",
  "references": [
    "https://www.cve.org/CVERecord?id=CVE-2026-48939",
    "https://github.com/projectdiscovery/nuclei-templates/blob/22f1a14a7fce254b73d81a706f15fabeb93231b5/http/cves/2026/CVE-2026-48939.yaml",
    "https://github.com/ChiefYoru/CVE-2026-48939_PoC"
  ],
  "rule": {
    "schema_version": 1,
    "name": "iCagenda registration-upload containment",
    "scope": {
      "site_id": 1
    },
    "all": [
      {
        "field": "method",
        "op": "in",
        "value": [
          "POST"
        ]
      },
      {
        "field": "path",
        "op": "regex",
        "value": "^/index\\.php$"
      },
      {
        "field": "query",
        "op": "regex",
        "value": "^com_icagenda$",
        "key": "option"
      },
      {
        "field": "query",
        "op": "regex",
        "value": "^registration\\.submit$",
        "key": "task"
      },
      {
        "field": "header",
        "op": "regex",
        "value": "(?i)^multipart/form-data",
        "key": "Content-Type"
      }
    ],
    "action": "observe",
    "ttl_seconds": 3600
  },
  "tests": [
    {
      "method": "POST",
      "path": "/index.php?option=com_icagenda&task=registration.submit",
      "headers": {
        "Content-Type": "multipart/form-data; boundary=example"
      },
      "body": "",
      "name": "operation blocked including legitimate uses",
      "expected_match": true
    },
    {
      "method": "POST",
      "path": "/index.php?option=com_icagenda&task=registration.submit",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "body": "",
      "name": "nonmatching synthetic request",
      "expected_match": false
    },
    {
      "method": "GET",
      "path": "/aegis-rule-control-health",
      "headers": {},
      "body": "",
      "name": "ordinary health request",
      "expected_match": false
    }
  ]
}
