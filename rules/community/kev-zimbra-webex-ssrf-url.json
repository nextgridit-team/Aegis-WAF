{
  "schema_version": 1,
  "revision": 1,
  "id": "kev-zimbra-webex-ssrf-url",
  "pack": "Zimbra Collaboration Suite request guards",
  "technology": [
    "synacor",
    "http"
  ],
  "cves": [
    "CVE-2020-7796"
  ],
  "description": "Partial request-pattern mitigation. Rejects HTTP URL values supplied as a WebEx company identifier.",
  "affected_versions": "n/a n/a: n/a; verify complete affected/fixed ranges and deployment prerequisites in the linked CNA/vendor records.",
  "coverage": "Rejects HTTP URL values supplied as a WebEx company identifier.",
  "limitations": "Only the declared request facts and bounded native matcher are covered. No vulnerable-deployment reproduction was performed. Direct-origin access, alternate routes/encodings and uninspectable facts remain outside this rule. Apply vendor fixes; this is not complete CVE protection.",
  "false_positive_risk": "Deployments intentionally configuring URL-shaped company IDs are denied.",
  "references": [
    "https://www.cve.org/CVERecord?id=CVE-2020-7796",
    "https://github.com/projectdiscovery/nuclei-templates/blob/22f1a14a7fce254b73d81a706f15fabeb93231b5/http/cves/2020/CVE-2020-7796.yaml",
    "https://www.adminxe.com/2183.html",
    "https://wiki.zimbra.com/wiki/Zimbra_Releases/8.8.15/P7",
    "https://github.com/ARPSyndicate/cvemon",
    "https://github.com/ARPSyndicate/kenzer-templates"
  ],
  "rule": {
    "schema_version": 1,
    "name": "Zimbra WebEx URL-input guard",
    "scope": {
      "site_id": 1
    },
    "all": [
      {
        "field": "path",
        "op": "regex",
        "value": "^/zimlet/com_zimbra_webex/httpPost\\.jsp$"
      },
      {
        "field": "query",
        "op": "regex",
        "value": "(?i)^https?://",
        "key": "companyId"
      }
    ],
    "action": "observe",
    "ttl_seconds": 3600
  },
  "tests": [
    {
      "method": "GET",
      "path": "/zimlet/com_zimbra_webex/httpPost.jsp?companyId=http%3A%2F%2Fexample.invalid%2F%23",
      "headers": {},
      "body": "",
      "name": "matching synthetic request",
      "expected_match": true
    },
    {
      "method": "GET",
      "path": "/zimlet/com_zimbra_webex/httpPost.jsp?companyId=example-company",
      "headers": {},
      "body": "",
      "name": "nonmatching synthetic request",
      "expected_match": false
    },
    {
      "method": "GET",
      "path": "/aegis-rule-control-health",
      "headers": {},
      "body": "",
      "name": "ordinary health request",
      "expected_match": false
    }
  ]
}
