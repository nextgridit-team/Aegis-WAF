{
  "schema_version": 1,
  "revision": 1,
  "id": "kev-biotime-file-traversal",
  "pack": "BioTime request guards",
  "technology": [
    "zkteco",
    "http"
  ],
  "cves": [
    "CVE-2023-38950"
  ],
  "description": "Partial request-pattern mitigation. Rejects parent-directory components in the BioTime file url argument.",
  "affected_versions": "n/a n/a: n/a; verify complete affected/fixed ranges and deployment prerequisites in the linked CNA/vendor records.",
  "coverage": "Rejects parent-directory components in the BioTime file url argument.",
  "limitations": "Only the declared request facts and bounded native matcher are covered. No vulnerable-deployment reproduction was performed. Direct-origin access, alternate routes/encodings and uninspectable facts remain outside this rule. Apply vendor fixes; this is not complete CVE protection.",
  "false_positive_risk": "Legitimate parent-relative file URLs are denied.",
  "references": [
    "https://www.cve.org/CVERecord?id=CVE-2023-38950",
    "https://github.com/projectdiscovery/nuclei-templates/blob/22f1a14a7fce254b73d81a706f15fabeb93231b5/http/cves/2023/CVE-2023-38950.yaml",
    "https://github.com/advisories/GHSA-4m8x-4g54-h49v",
    "https://claroty.com/team82/disclosure-dashboard/cve-2023-38950",
    "https://www.fortinet.com/content/dam/fortinet/assets/reports/report-incident-response-middle-east.pdf"
  ],
  "rule": {
    "schema_version": 1,
    "name": "BioTime file-URL traversal guard",
    "scope": {
      "site_id": 1
    },
    "all": [
      {
        "field": "path",
        "op": "regex",
        "value": "^/iclock/file/?$"
      },
      {
        "field": "query",
        "op": "regex",
        "value": "(?:\\.\\.[/\\\\]|%2e)",
        "key": "url"
      }
    ],
    "action": "observe",
    "ttl_seconds": 3600
  },
  "tests": [
    {
      "method": "GET",
      "path": "/iclock/file?url=%2F..%2F..%2Fwindows%2Fwin.ini",
      "headers": {},
      "body": "",
      "name": "matching synthetic request",
      "expected_match": true
    },
    {
      "method": "GET",
      "path": "/iclock/file?url=%2Fmedia%2Fexample.png",
      "headers": {},
      "body": "",
      "name": "nonmatching synthetic request",
      "expected_match": false
    },
    {
      "method": "GET",
      "path": "/aegis-rule-control-health",
      "headers": {},
      "body": "",
      "name": "ordinary health request",
      "expected_match": false
    }
  ]
}
