  "rule": {
    "schema_version": 1,
    "name": "Cisco WebVPN path traversal guard",
    "scope": {
      "site_id": 1
    },
    "all": [
      {
        "field": "path",
        "op": "regex",
        "value": "^/\\+CSCOU\\+/"
