{
  "schema_version": 1,
  "revision": 1,
  "id": "kev-balbooa-upload-containment",
  "pack": "Forms request guards",
  "technology": [
    "balbooa",
    "http"
  ],
  "cves": [
    "CVE-2026-56291"
  ],
  "description": "Temporary endpoint containment. Blocks the identified Balbooa attachment-upload operation.",
  "affected_versions": "balbooa.com balbooa.com Balbooa Forms extension for Joomla: 1.0-2.4.0; verify complete affected/fixed ranges and deployment prerequisites in the linked CNA/vendor records.",
  "coverage": "Blocks the identified Balbooa attachment-upload operation.",
  "limitations": "Only the declared request facts and bounded native matcher are covered. No vulnerable-deployment reproduction was performed. Direct-origin access, alternate routes/encodings and uninspectable facts remain outside this rule. Apply vendor fixes; this is not complete CVE protection.",
  "false_positive_risk": "Blocks legitimate attachments too; use only when that upload operation can be disabled.",
  "references": [
    "https://www.cve.org/CVERecord?id=CVE-2026-56291",
    "https://github.com/projectdiscovery/nuclei-templates/blob/22f1a14a7fce254b73d81a706f15fabeb93231b5/http/cves/2026/CVE-2026-56291.yaml",
    "https://www.cisa.gov/known-exploited-vulnerabilities-catalog"
  ],
  "rule": {
    "schema_version": 1,
    "name": "Balbooa attachment-upload containment",
    "scope": {
      "site_id": 1
    },
    "all": [
      {
        "field": "method",
        "op": "in",
        "value": [
          "POST"
        ]
      },
      {
        "field": "path",
        "op": "regex",
        "value": "^/index\\.php$"
      },
      {
        "field": "query",
        "op": "regex",
        "value": "^com_baforms$",
        "key": "option"
      },
      {
        "field": "query",
        "op": "regex",
        "value": "^form\\.uploadAttachmentFile$",
        "key": "task"
      }
    ],
    "action": "observe",
    "ttl_seconds": 3600
  },
  "tests": [
    {
      "method": "POST",
      "path": "/index.php?option=com_baforms&task=form.uploadAttachmentFile",
      "headers": {},
      "body": "",
      "name": "operation blocked including legitimate uses",
      "expected_match": true
    },
    {
      "method": "POST",
      "path": "/index.php?option=com_baforms&task=form.view",
      "headers": {},
      "body": "",
      "name": "nonmatching synthetic request",
      "expected_match": false
    },
    {
      "method": "GET",
      "path": "/aegis-rule-control-health",
      "headers": {},
      "body": "",
      "name": "ordinary health request",
      "expected_match": false
    }
  ]
}
