{
  "schema_version": 1,
  "revision": 2,
  "id": "node-brotli-request-guard",
  "pack": ".NET and Node.js Brotli request guard",
  "technology": [
    "dotnet",
    "aspnetcore",
    "nodejs",
    "brotli"
  ],
  "cves": [
    "CVE-2026-111497"
  ],
  "description": "Match declared Brotli request encoding on .NET/ASP.NET Core and Node.js applications; block it where Brotli-compressed uploads are unnecessary.",
  "affected_versions": ".NET 8.0.0 through 8.0.32, 9.0.0 through 9.0.21, 10.0.0 through 10.0.13, and affected .NET 11 previews before 11.0.0-rc.3.26522.148; see Microsoft for package-specific preview ranges. .NET Framework is unaffected. Exposure requires decoding untrusted Brotli, such as explicitly enabled ASP.NET Core request decompression. Also applies to affected Node.js 22.x, 24.x and 26.x builds in the Node.js advisory.",
  "coverage": "Matches a case-insensitive br token in Content-Encoding, including comma-separated encoding lists, on any request method or path. With effective Block enforcement, rejects declared Brotli request delivery before the upstream; Observe records the match without blocking.",
  "limitations": "Partial delivery-path mitigation, not a malicious Brotli payload detector or runtime-version check. Does not cover unlabelled files, application-specific BrotliStream/BrotliDecoder use without this header, outbound HttpClient/Node.js downloads, direct-origin access or oversized/uninspectable header facts. Patch the runtime; rebuild and redeploy self-contained/NativeAOT applications. ASP.NET Core request decompression is not enabled by default.",
  "false_positive_risk": "Blocks legitimate Brotli-compressed uploads as well as malicious streams. Apply only where this request encoding is unnecessary, or use Observe to assess compatibility. Accept-Encoding: br response negotiation and other request encodings such as gzip/deflate are unaffected.",
  "references": [
    "https://github.com/dotnet/runtime/security/advisories/GHSA-p3jp-9v83-76w9",
    "https://nodejs.org/en/blog/vulnerability/october-2026-security-releases"
  ],
  "rule": {
    "schema_version": 1,
    "name": ".NET and Node.js Brotli request guard",
    "scope": {
      "site_id": 1
    },
    "all": [
      {
        "field": "header",
        "key": "Content-Encoding",
        "op": "regex",
        "value": "(?i)(?:^|,)[\\t ]*br[\\t ]*(?:,|$)"
      }
    ],
    "action": "observe",
    "ttl_seconds": 3600
  },
  "tests": [
    {
      "name": "ASP.NET Core declared Brotli upload",
      "method": "POST",
      "path": "/api/upload",
      "headers": {
        "Content-Encoding": "br"
      },
      "body": "synthetic compressed-body placeholder",
      "expected_match": true
    },
    {
      "name": "uppercase encoding on PUT",
      "method": "PUT",
      "path": "/api/documents/1",
      "headers": {
        "Content-Encoding": "BR"
      },
      "body": "",
      "expected_match": true
    },
    {
      "name": "encoding list",
      "method": "POST",
      "path": "/",
      "headers": {
        "Content-Encoding": "gzip, br"
      },
      "body": "",
      "expected_match": true
    },
    {
      "name": "ordinary gzip",
      "method": "POST",
      "path": "/",
      "headers": {
        "Content-Encoding": "gzip"
      },
      "body": "",
      "expected_match": false
    },
    {
      "name": "unrelated token",
      "method": "POST",
      "path": "/",
      "headers": {
        "Content-Encoding": "zebra"
      },
      "body": "",
      "expected_match": false
    },
    {
      "name": "no encoding",
      "method": "POST",
      "path": "/",
      "headers": {},
      "body": "",
      "expected_match": false
    },
    {
      "name": "tab whitespace",
      "method": "POST",
      "path": "/",
      "headers": {
        "Content-Encoding": "gzip,\tbr"
      },
      "body": "",
      "expected_match": true
    },
    {
      "name": "surrounding optional whitespace on PATCH",
      "method": "PATCH",
      "path": "/api/upload",
      "headers": {
        "Content-Encoding": " \tBR \t"
      },
      "body": "",
      "expected_match": true
    },
    {
      "name": "Brotli first in encoding list",
      "method": "POST",
      "path": "/api/upload",
      "headers": {
        "Content-Encoding": "br, gzip"
      },
      "body": "",
      "expected_match": true
    },
    {
      "name": "Brotli inside encoding list",
      "method": "POST",
      "path": "/api/upload",
      "headers": {
        "Content-Encoding": "gzip, Br, deflate"
      },
      "body": "",
      "expected_match": true
    },
    {
      "name": "response negotiation is not request encoding",
      "method": "GET",
      "path": "/",
      "headers": {
        "Accept-Encoding": "gzip, br"
      },
      "body": "",
      "expected_match": false
    },
    {
      "name": "content type alone is outside this guard",
      "method": "POST",
      "path": "/api/upload",
      "headers": {
        "Content-Type": "application/brotli"
      },
      "body": "",
      "expected_match": false
    },
    {
      "name": "prefixed encoding token",
      "method": "POST",
      "path": "/api/upload",
      "headers": {
        "Content-Encoding": "x-br"
      },
      "body": "",
      "expected_match": false
    },
    {
      "name": "spelled-out encoding is not br",
      "method": "POST",
      "path": "/api/upload",
      "headers": {
        "Content-Encoding": "brotli"
      },
      "body": "",
      "expected_match": false
    },
    {
      "name": "ordinary deflate with Brotli response negotiation",
      "method": "POST",
      "path": "/api/upload",
      "headers": {
        "Content-Encoding": "deflate",
        "Accept-Encoding": "br"
      },
      "body": "",
      "expected_match": false
    },
    {
      "name": "declared Brotli on GET",
      "method": "GET",
      "path": "/",
      "headers": {
        "Content-Encoding": "br"
      },
      "body": "",
      "expected_match": true
    }
  ]
}
