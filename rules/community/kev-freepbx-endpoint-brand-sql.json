{
  "schema_version": 1,
  "revision": 1,
  "id": "kev-freepbx-endpoint-brand-sql",
  "pack": "FreePBX request guards",
  "technology": [
    "sangoma",
    "http"
  ],
  "cves": [
    "CVE-2025-57819"
  ],
  "description": "Partial request-pattern mitigation. Rejects selected SQL syntax in the endpoint model brand query parameter.",
  "affected_versions": "FreePBX endpoint: < 15.0.66, < 16.0.89, < 17.0.3; verify complete affected/fixed ranges and deployment prerequisites in the linked CNA/vendor records.",
  "coverage": "Rejects selected SQL syntax in the endpoint model brand query parameter.",
  "limitations": "Only the declared request facts and bounded native matcher are covered. No vulnerable-deployment reproduction was performed. Direct-origin access, alternate routes/encodings and uninspectable facts remain outside this rule. Apply vendor fixes; this is not complete CVE protection.",
  "false_positive_risk": "Legitimate brand names containing apostrophes or SQL punctuation are denied.",
  "references": [
    "https://www.cve.org/CVERecord?id=CVE-2025-57819",
    "https://github.com/projectdiscovery/nuclei-templates/blob/22f1a14a7fce254b73d81a706f15fabeb93231b5/http/cves/2025/CVE-2025-57819.yaml",
    "https://github.com/FreePBX/security-reporting/security/advisories/GHSA-m42g-xg4c-5f3h",
    "https://community.freepbx.org/t/security-advisory-please-lock-down-your-administrator-access/107203",
    "https://github.com/watchtowrlabs/watchTowr-vs-FreePBX-CVE-2025-57819",
    "https://labs.watchtowr.com/you-already-have-our-personal-data-take-our-phone-calls-too-freepbx-cve-2025-57819/"
  ],
  "rule": {
    "schema_version": 1,
    "name": "FreePBX endpoint brand SQL guard",
    "scope": {
      "site_id": 1
    },
    "all": [
      {
        "field": "path",
        "op": "regex",
        "value": "^/admin/ajax\\.php$"
      },
      {
        "field": "query",
        "op": "regex",
        "value": "^model$",
        "key": "command"
      },
      {
        "field": "query",
        "op": "regex",
        "value": "(?i)(?:[';]|\\b(?:extractvalue|union\\s+select)\\b)",
        "key": "brand"
      }
    ],
    "action": "observe",
    "ttl_seconds": 3600
  },
  "tests": [
    {
      "method": "GET",
      "path": "/admin/ajax.php?command=model&brand=example%27+AND+EXTRACTVALUE%281%2C1%29--",
      "headers": {},
      "body": "",
      "name": "matching synthetic request",
      "expected_match": true
    },
    {
      "method": "GET",
      "path": "/admin/ajax.php?command=model&brand=example",
      "headers": {},
      "body": "",
      "name": "nonmatching synthetic request",
      "expected_match": false
    },
    {
      "method": "GET",
      "path": "/aegis-rule-control-health",
      "headers": {},
      "body": "",
      "name": "ordinary health request",
      "expected_match": false
    }
  ]
}
