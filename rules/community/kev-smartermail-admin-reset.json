{
  "schema_version": 1,
  "revision": 1,
  "id": "kev-smartermail-admin-reset",
  "pack": "SmarterMail request guards",
  "technology": [
    "smartertools",
    "http"
  ],
  "cves": [
    "CVE-2026-23760"
  ],
  "description": "Partial request-pattern mitigation. Rejects system-administrator force-reset requests carrying the documented JSON flag.",
  "affected_versions": "SmarterTools SmarterMail: 0 to <100.0.9511; verify complete affected/fixed ranges and deployment prerequisites in the linked CNA/vendor records.",
  "coverage": "Rejects system-administrator force-reset requests carrying the documented JSON flag.",
  "limitations": "Only the declared request facts and bounded native matcher are covered. No vulnerable-deployment reproduction was performed. Direct-origin access, alternate routes/encodings and uninspectable facts remain outside this rule. Apply vendor fixes; this is not complete CVE protection.",
  "false_positive_risk": "Legitimate administrator password resets using this route/flag are denied.",
  "references": [
    "https://www.cve.org/CVERecord?id=CVE-2026-23760",
    "https://github.com/projectdiscovery/nuclei-templates/blob/22f1a14a7fce254b73d81a706f15fabeb93231b5/http/cves/2026/CVE-2026-23760.yaml",
    "https://labs.watchtowr.com/attackers-with-decompilers-strike-again-smartertools-smartermail-wt-2026-0001-auth-bypass/"
  ],
  "rule": {
    "schema_version": 1,
    "name": "SmarterMail system-admin reset guard",
    "scope": {
      "site_id": 1
    },
    "all": [
      {
        "field": "method",
        "op": "in",
        "value": [
          "POST"
        ]
      },
      {
        "field": "path",
        "op": "regex",
        "value": "^/api/v1/auth/force-reset-password/?$"
      },
      {
        "field": "json_body",
        "op": "regex",
        "value": "(?i)^true$",
        "key": "/IsSysAdmin"
      }
    ],
    "action": "observe",
    "ttl_seconds": 3600
  },
  "tests": [
    {
      "method": "POST",
      "path": "/api/v1/auth/force-reset-password",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"IsSysAdmin\": true}",
      "name": "matching synthetic request",
      "expected_match": true
    },
    {
      "method": "POST",
      "path": "/api/v1/auth/force-reset-password",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"IsSysAdmin\": false}",
      "name": "nonmatching synthetic request",
      "expected_match": false
    },
    {
      "method": "GET",
      "path": "/aegis-rule-control-health",
      "headers": {},
      "body": "",
      "name": "ordinary health request",
      "expected_match": false
    }
  ]
}
